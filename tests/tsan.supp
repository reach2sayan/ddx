# ThreadSanitizer suppressions.
#
# LLVM sits inside libddx uninstrumented, so TSan sees its writes but not the
# synchronisation guarding them, and ignore_noninstrumented_modules cannot tell
# it from the instrumented module around it; these name it by frame instead.
race:llvm::
deadlock:llvm::

# ROCm's OpenCL runtime starts a thread when the ICD loader enumerates it and
# never joins it, so every device test ends with a leak in the driver.
thread:libhsa-runtime64
