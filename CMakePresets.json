{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "jit",
      "hidden": true,
      "cacheVariables": {
        "DDX_BUILD_JIT": "ON",
        "LLVM_DIR": "/usr/lib/llvm-20/lib/cmake/llvm"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "cl",
      "hidden": true,
      "cacheVariables": {
        "DDX_BUILD_OPENCL": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "The library and the runtime expression graph, interpreted.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "The library and the runtime expression graph, optimised.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug_jit",
      "displayName": "Debug + JIT",
      "description": "The LLVM backend compiled into libddx. Kernels compile at -O1, which still vectorises.",
      "inherits": [
        "jit",
        "debug"
      ]
    },
    {
      "name": "debug_jit_tsan",
      "displayName": "Debug + JIT + ThreadSanitizer",
      "description": "Everything in the tree instrumented, gtest included. The LLVM inside libddx is not, so tests/tsan.supp names it by frame.",
      "inherits": [
        "debug_jit"
      ],
      "cacheVariables": {
        "DDX_SANITIZE": "thread"
      }
    },
    {
      "name": "release_jit",
      "displayName": "Release + JIT",
      "description": "The LLVM backend compiled into libddx. Kernels compile at -O3.",
      "inherits": [
        "jit",
        "release"
      ]
    },
    {
      "name": "release_cl",
      "displayName": "Release + OpenCL",
      "description": "The OpenCL device backend compiled into libddx whatever this host has, and no JIT: what CI's opencl job builds.",
      "inherits": [
        "cl",
        "release"
      ]
    },
    {
      "name": "debug_jit_cl",
      "displayName": "Debug + JIT + OpenCL",
      "description": "Both backends in one libddx.",
      "inherits": [
        "cl",
        "jit",
        "debug"
      ]
    },
    {
      "name": "python",
      "displayName": "Release + JIT + Python",
      "description": "The extension module beside the library, and pytest as a ctest. Python comes from .venv, which is where uv put pybind11 and numpy.",
      "inherits": [
        "jit",
        "release"
      ],
      "cacheVariables": {
        "DDX_BUILD_PYTHON": "ON",
        "Python_ROOT_DIR": "${sourceDir}/.venv",
        "Python_FIND_VIRTUALENV": "ONLY"
      }
    },
    {
      "name": "python_no_jit",
      "displayName": "Release + Python, no JIT",
      "description": "The same module with the backend left out: one shape, no kernel, the sweep answers everything. What proves DDX_BUILD_JIT=OFF still builds and still computes.",
      "inherits": [
        "release"
      ],
      "cacheVariables": {
        "DDX_BUILD_PYTHON": "ON",
        "Python_ROOT_DIR": "${sourceDir}/.venv",
        "Python_FIND_VIRTUALENV": "ONLY"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug_jit",
      "configurePreset": "debug_jit"
    },
    {
      "name": "debug_jit_tsan",
      "configurePreset": "debug_jit_tsan"
    },
    {
      "name": "release_jit",
      "configurePreset": "release_jit"
    },
    {
      "name": "release_cl",
      "configurePreset": "release_cl"
    },
    {
      "name": "debug_jit_cl",
      "configurePreset": "debug_jit_cl"
    },
    {
      "name": "python",
      "configurePreset": "python"
    },
    {
      "name": "python_no_jit",
      "configurePreset": "python_no_jit"
    }
  ],
  "testPresets": [
    {
      "name": "tbase",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "tbase",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "tbase",
      "configurePreset": "release"
    },
    {
      "name": "debug_jit",
      "inherits": "tbase",
      "configurePreset": "debug_jit"
    },
    {
      "name": "debug_jit_tsan",
      "configurePreset": "debug_jit_tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release_jit",
      "inherits": "tbase",
      "configurePreset": "release_jit"
    },
    {
      "name": "release_cl",
      "inherits": "tbase",
      "configurePreset": "release_cl"
    },
    {
      "name": "debug_jit_cl",
      "inherits": "tbase",
      "configurePreset": "debug_jit_cl"
    },
    {
      "name": "python",
      "inherits": "tbase",
      "configurePreset": "python"
    },
    {
      "name": "python_no_jit",
      "inherits": "tbase",
      "configurePreset": "python_no_jit"
    }
  ]
}
